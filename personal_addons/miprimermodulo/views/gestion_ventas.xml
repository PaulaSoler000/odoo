<odoo>
    <record id="view_miprimermodulo_form" model="ir.ui.view">
        <field name="name">miprimermodulo.form</field>
        <field name="model">miprimermodulo.model</field>
        <field name="arch" type="xml">
            <form string="Mi Primer Modulo">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_miprimermodulo_tree" model="ir.ui.view">
        <field name="name">miprimermodulo.tree</field>
        <field name="model">miprimermodulo.model</field>
        <field name="arch" type="xml">
            <tree string="Mi Primer Modulo">
                <field name="name"/>
                <field name="description"/>
            </tree>
        </field>
    </record>

     <record id="action_miprimermodulo" model="ir.actions.act_window">
        <field name="name">Mi Primer Modulo</field>
        <field name="res_model">miprimermodulo.model</field>
        <field name="view_type">form</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Click to create a new record.
            </p>
        </field>
    </record>

    <menuitem id="menu_miprimermodulo" name="Mi Primer Modulo" parent="base.menu_sales" sequence="10"/>
    <menuitem id="menu_miprimermodulo_ventas" name="Ventas" parent="menu_miprimermodulo" sequence="10"/>  
</odoo>